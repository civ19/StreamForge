{
    "configurations": [
        {
            "name": "ESP-IDF",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/main",
                "${workspaceFolder}/main/spi_pipeline",
                "${workspaceFolder}../shared/utils"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}"
